# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://your-domain.com"

# MONGODB_URI: Required for connecting to your MongoDB Atlas database.
MONGODB_URI="mongodb+srv://username:password@cluster.example.mongodb.net/cobultstocks"

# SMTP Configuration for Email Notifications
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=465
SMTP_SECURE="true"
SMTP_USER="your-mailbox@example.com"
SMTP_PASS="your-smtp-password-or-app-password"
SMTP_FROM='"Cobult Stocks" <your-mailbox@example.com>'

